# Configurações do EmailJS (Necessárias para o formulário de contato funcionar)
# Crie uma conta gratuita em https://www.emailjs.com/ e substitua os valores abaixo com os da sua conta.

VITE_EMAILJS_SERVICE_ID=seu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=seu_template_id_aqui
VITE_EMAILJS_PUBLIC_KEY=sua_public_key_aqui
